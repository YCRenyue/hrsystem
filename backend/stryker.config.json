{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "jest": { "projectType": "custom", "enableFindRelatedTests": true },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "mutate": [
    "src/services/punch/workSchedule.js",
    "src/services/punch/attendancePunchImport.js",
    "src/services/attendanceReportService.js",
    "src/services/LeaveWorkflowService.js",
    "src/services/AnnualLeaveService.js",
    "src/services/ReimbursementService.js",
    "src/services/BusinessTripService.js",
    "src/services/SocialSecurityCalculationService.js",
    "src/services/DataScopeService.js",
    "src/services/approvalService.js"
  ]
}
